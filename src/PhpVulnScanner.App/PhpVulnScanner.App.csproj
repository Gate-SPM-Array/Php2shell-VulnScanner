<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>PhpVulnScanner</AssemblyName>
    <RootNamespace>PhpVulnScanner.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>it;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Pubblicazione portable: un solo eseguibile autonomo, nessun runtime .NET da installare -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhpVulnScanner.Core\PhpVulnScanner.Core.csproj" />
    <Resource Include="app.ico" />
    <EmbeddedResource Include="Help\Guida.html" LogicalName="Guida.html" />
    <EmbeddedResource Include="Help\Guide.html" LogicalName="Guide.html" />
    <!-- file di lingua esterni, modificabili: copiati in lang\ accanto all'eseguibile (hanno la precedenza sulla copia incorporata) -->
    <None Include="..\..\lang\*.json" Link="lang\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- database applicazioni (firme Wappalyzer + inventario NCSC-NL, con licenze e versione dei dati): copiato in data\ accanto all'eseguibile, aggiornabile -->
    <None Include="..\..\data\*.json;..\..\data\*.txt" Link="data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
